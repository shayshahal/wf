# Class-B pathspec for JewelryX rounds, read by classify.mjs as core.attributesFile (process/CLASSES.md).
# wf-class: workflow-v2 triage (Task 1). Last match wins, so the default A comes FIRST.
# B = contract-touching; C is set by the orchestrator, never by paths. See JewelryX-Tools/wf/process/CLASSES.md.
** wf-class=A
packages/backend/app/models/** wf-class=B
packages/backend/app/schemas/** wf-class=B
packages/backend/app/api/** wf-class=B
packages/backend/openapi.json wf-class=B
packages/frontend/*/src/lib/*.remote.ts wf-class=B
packages/frontend/*/src/lib/**/*.remote.ts wf-class=B
packages/frontend/*/src/lib/server/** wf-class=B
packages/frontend/shared/** wf-class=B
**/auth/** wf-class=B
**/permissions* wf-class=B
**/core/security* wf-class=B
package.json wf-class=B
pnpm-lock.yaml wf-class=B
pyproject.toml wf-class=B
requirements.txt wf-class=B
# Least reversible, or reaching past the app (with-agents.dev "keep consequential decisions human", 2026-09-23):
packages/backend/migrations/** wf-class=B
packages/backend/scripts/migrate* wf-class=B
packages/backend/app/core/config.py wf-class=B
.github/** wf-class=B
docker-compose*.yml wf-class=B
infrastructure/** wf-class=B
