{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^wf:round-worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wf.mjs",
              "handoff",
              "record"
            ]
          }
        ]
      }
    ]
  }
}
