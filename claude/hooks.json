{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^wf:round-worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wf.mjs",
              "handoff",
              "check"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wf.mjs",
              "handoff",
              "no-fork"
            ]
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/wf.mjs",
              "handoff",
              "check"
            ]
          }
        ]
      }
    ]
  }
}
